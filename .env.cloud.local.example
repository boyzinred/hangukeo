# The hosted Supabase project. Used by `db:migrate:cloud`, `db:seed:cloud`
# and `user:create:cloud`.
#
# All three values must name the SAME project. Creating an account writes the
# sign-in user to Supabase Auth and the roster row to Postgres, so a file that
# mixes a cloud database with a local API — or with another project — makes
# accounts that are broken in a way nothing later reports. The scripts check
# and refuse, but it is easier not to mix them.
#
# This file is gitignored. Keep the secret key in your password manager too.

# Project Settings → Database → Connection string → URI.
# Transaction pooler (port 6543) is the one to use from a serverless host;
# session pooler (5432) is fine for running these scripts from a laptop.
#   postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Project Settings → Data API → Project URL.
#   https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API keys → service_role.
# Server-only, and can create or delete any account. Never prefix it with
# NEXT_PUBLIC_, never commit it, never put it in the browser.
SUPABASE_SECRET_KEY=
